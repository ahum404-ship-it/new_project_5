import random

CHOICES = ["rock", "paper", "scissors"]


def get_player_choice():
    # keep asking until they type something valid
    choice = input("Enter rock, paper, scissors: ").lower().strip()
    while choice not in CHOICES:
        print(f'Sorry, "{choice}" is not a valid choice. Please try again.')
        choice = input("Enter rock, paper, scissors: ").lower().strip()
    return choice


def determine_winner(player, computer):
    if player == computer:
        return "tie"
    # these are the combos where the player comes out on top
    if (player == "rock" and computer == "scissors") or \
       (player == "paper" and computer == "rock") or \
       (player == "scissors" and computer == "paper"):
        return "win"
    return "loss"


def get_rounds():
    while True:
        answer = input("How many rounds would you like to play: ")
        try:
            rounds = int(answer)
        except ValueError:
            print("Sorry, that's not a number. Please try again.")
            continue

        if rounds < 1 or rounds % 2 == 0:
            print("Sorry, the number must be an odd number. Please try again.")
        else:
            return rounds


def main():
    print("Welcome to Rock Paper Scissors!")
    rounds = get_rounds()

    player_wins = 0
    computer_wins = 0

    # ties don't count, so loop on the actual decided rounds
    while player_wins + computer_wins < rounds:
        player = get_player_choice()
        computer = random.choice(CHOICES)
        print(f"The computer chose {computer}.")

        result = determine_winner(player, computer)

        if result == "win":
            print("You won!")
            player_wins += 1
        elif result == "loss":
            print("You lost!")
            computer_wins += 1
        else:
            print("Tie! Play again.")

    print("-------------------------------------------")
    print(f"Score — You: {player_wins} | Computer: {computer_wins}")

    if player_wins > computer_wins:
        print("You win!!!")
    else:
        print("The computer wins!")
    print("Thanks for playing!")


if __name__ == "__main__":
    main()
